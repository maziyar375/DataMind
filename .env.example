# Generate both of these before first run:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_BOX_KEY=
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

ADMIN_EMAIL=admin@raymand.com
ADMIN_PASSWORD=raymand

DATABASE_URL=postgresql+asyncpg://raymand:raymand@localhost:5432/raymand
ENVIRONMENT=local
DEBUG=true

# ── access control ───────────────────────────────────────────────────────
# Which implementation of the `Authorizer` port answers "may they?".
# `owner_only` is the rule the product shipped with — you may act on a row if
# you own it. `rbac` adds grants, teams and role scoped privileges on top of
# ownership. The flip is reversible in both directions without a migration.
AUTHZ_BACKEND=owner_only
# Who verifies a human. `local` is the only value today; `oidc` is §20 of
# docs/user-management-and-access-control-plan.md.
AUTH_PROVIDER=local
# May a service account hold user.manage, role.manage, service_user.manage or
# settings.manage? No, by default: a leaked API key must not be able to mint an
# administrator. Turn it on only for an agent that genuinely provisions
# accounts — every use of it writes a `service_user.privileged` audit row.
ALLOW_PRIVILEGED_SERVICE_USERS=false
# How long a new API key lasts when the caller names no expiry. A year, not
# forever: an unexpiring machine credential is the one thing every published
# key-leak incident has in common. 0 means no default expiry.
SERVICE_KEY_DEFAULT_TTL_DAYS=365
